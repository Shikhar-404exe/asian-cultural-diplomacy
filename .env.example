# ==============================================================================
# Asian Cultural Diplomacy Platform — Environment Variables Template
# Copy this file to .env.local or set these variables in your deployment dashboard.
# NEVER commit files containing real production credentials.
# ==============================================================================

# Core Application Settings
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cryptographic Session Signing Secret (Generate 64-char hex in production: openssl rand -hex 32)
SESSION_SECRET="replace_with_a_secure_random_64_character_hex_string_for_production"

# Database Connection (SQLite for local dev, PostgreSQL/Supabase for production/staging)
# Local: "file:./dev.db"
# Production: "postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DATABASE_URL="file:./dev.db"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Founder Administrator Provisioning (dynamically assigned on server)
ADMIN_EMAIL="founder@asianculturaldiplomacy.org"
ADMIN_PASSWORD="replace_with_strong_master_password"
ADMIN_NAME="Founder & Director"

# Supabase Managed Cloud Storage (Production & Staging)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="media"

# Google / Gmail Notification Delivery (OAuth 2.0 or App Password)
GMAIL_USER="founder@asianculturaldiplomacy.org"
GMAIL_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GMAIL_CLIENT_SECRET="your-google-client-secret"
GMAIL_REFRESH_TOKEN="your-google-refresh-token"
# Alternative fallback:
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# Google Reader OAuth Sign-In (Optional)
GOOGLE_CLIENT_ID="your-google-reader-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-reader-client-secret"
